# =============================================================================
# EduVote Pro - Environment Variables (example)
# =============================================================================
# Copy this file to ".env" and fill in real values.
# The Secrets Gradle Plugin reads ".env" at build time and exposes keys as
# BuildConfig fields. NEVER commit your real ".env" file (it is gitignored).
# =============================================================================

# Telegram Bot token used by TelegramService / TelegramForegroundService to
# poll commands and send charts, reports, DB exports, etc.
# Obtain from @BotFather in Telegram. Format: "<bot_id>:<random_token>"
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Telegram chat ID that the bot sends messages / media to.
# Use @userinfobot or similar to look up your numeric chat ID.
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Optional: channel name used for the persistent foreground-service notification.
# Defaults to "EduVote Service" if left blank.
TELEGRAM_SERVICE_CHANNEL=
